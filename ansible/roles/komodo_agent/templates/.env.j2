COMPOSE_KOMODO_IMAGE_TAG=2.3.2
TZ=Europe/Madrid

PERIPHERY_CORE_ADDRESS={{ komodo_agent_core_address }}
PERIPHERY_CONNECT_AS={{ inventory_hostname }}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# Must match the compose.yaml bind mount exactly (host path == container
# path) - Periphery drives the host's dockerd over the socket, so any
# relative stack path it resolves has to already be a valid host path.
PERIPHERY_ROOT_DIRECTORY=/srv/docker/komodo

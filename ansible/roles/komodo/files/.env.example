## Copy to .env (gitignored) and fill in real values - see docker/README.md.
## Pinned to a specific release, not the floating "2" tag, so a re-run can't
## silently pull a different version onto the host.
COMPOSE_KOMODO_IMAGE_TAG=2.3.2
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## DB credentials - generate with: openssl rand -hex 24
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=<openssl rand -hex 24>

TZ=Europe/Madrid

KOMODO_HOST=http://192.168.9.10:9120
KOMODO_TITLE=Komodo

KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
## generate with: openssl rand -hex 24
KOMODO_INIT_ADMIN_PASSWORD=<openssl rand -hex 24>

KOMODO_FIRST_SERVER_NAME=panel

## generate with: openssl rand -hex 32
KOMODO_WEBHOOK_SECRET=<openssl rand -hex 32>
## generate with: openssl rand -hex 32
KOMODO_JWT_SECRET=<openssl rand -hex 32>
KOMODO_JWT_TTL=1-day

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname

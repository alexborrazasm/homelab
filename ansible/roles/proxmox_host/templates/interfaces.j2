{{ ansible_managed | comment }}
# Source of truth: roles/proxmox_host/templates/interfaces.j2

auto lo
iface lo inet loopback

# --- Physical NICs ---

iface {{ proxmox_net_nic_lan }} inet manual

auto {{ proxmox_net_nic_lan }}.20
iface {{ proxmox_net_nic_lan }}.20 inet manual

auto {{ proxmox_net_nic_lan }}.30
iface {{ proxmox_net_nic_lan }}.30 inet manual

allow-hotplug {{ proxmox_net_nic_san }}
iface {{ proxmox_net_nic_san }} inet manual
    mtu {{ proxmox_net_vmbrsan_mtu }}
    # vmbrSAN (bridge-ports below) comes up at early boot before this
    # Thunderbolt/USB4 NIC has enumerated, so ifup never adds it as a
    # bridge port there ("bridge port enp4s0 does not exist"). allow-hotplug
    # gets the link itself up once udev sees it appear, but doesn't retroactively
    # join an already-up bridge - only this interface's own ifup does that,
    # so join it explicitly here. Confirmed live: without this, the NIC
    # comes up standalone but never gets bridged.
    post-up ip link set dev {{ proxmox_net_nic_san }} master vmbrSAN
    pre-down ip link set dev {{ proxmox_net_nic_san }} nomaster

iface {{ proxmox_net_nic_wifi }} inet manual

# --- Bridges ---

# LAN (VLAN 10, native/untagged on the switch trunk port).
auto vmbr0
iface vmbr0 inet static
    address {{ proxmox_net_vmbr0_address }}
    gateway {{ proxmox_net_vmbr0_gateway }}
    bridge-ports {{ proxmox_net_nic_lan }}
    bridge-stp off
    bridge-fd 0

# IOT (VLAN 20)
auto vmbr20
iface vmbr20 inet manual
    bridge-ports {{ proxmox_net_nic_lan }}.20
    bridge-stp off
    bridge-fd 0

# DMZ (VLAN 30)
auto vmbr30
iface vmbr30 inet manual
    bridge-ports {{ proxmox_net_nic_lan }}.30
    bridge-stp off
    bridge-fd 0

# Dedicated link to the NAS (NOT a VLAN). The host and any VM that needs
# fast NFS access to the NAS attach here directly.
auto vmbrSAN
iface vmbrSAN inet static
    address {{ proxmox_net_vmbrsan_address }}
    bridge-ports {{ proxmox_net_nic_san }}
    bridge-stp off
    bridge-fd 0
    mtu {{ proxmox_net_vmbrsan_mtu }}

source /etc/network/interfaces.d/*
